<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1221"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="PocketNav RFCOMM Telemetry"
        android:textColor="#F8FAFC"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="24-Byte Binary GPS Streamer &amp; Offline 3D MapLibre Dashboard"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPairedDeviceLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Target Paired Bluetooth Device (for Phone 1):"
        android:textColor="#CBD5E1"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spinnerPairedDevices"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:background="#1E293B"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnStartCommander"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#2563EB"
        android:text="Start as Commander (Phone 1)"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnStartDashboard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#059669"
        android:text="Start as Dashboard (Phone 2)"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCommanderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:padding="16dp"
        android:text="Status: Idle. Select a role above."
        android:textColor="#38BDF8"
        android:textSize="14sp"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/tvTelemetryReadout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#0F172A"
        android:padding="16dp"
        android:text="24-Byte Telemetry Frame Layout:\n[0..7]   Latitude  (Double, 8B)\n[8..15]  Longitude (Double, 8B)\n[16..19] Bearing   (Float,  4B)\n[20..23] Speed m/s (Float,  4B)"
        android:textColor="#E2E8F0"
        android:textSize="13sp"
        android:typeface="monospace" />

</LinearLayout>
