<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1221">

    <!-- Full-screen 3D MapLibre view rendering roads, route line, turn nodes, destination pin & puck -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Navigation Maneuver Banner (Next Turn Arrow, Distance to Turn, Road Name, BT Status) -->
    <LinearLayout
        android:id="@+id/layoutTopNavBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="14dp"
        android:background="#E60F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvTurnIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="#1E3A8A"
            android:gravity="center"
            android:text="↑"
            android:textColor="#38BDF8"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNextTurnDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNextTurnStreet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Share a place from Google Maps on Phone 1"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDashboardStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="WAITING BT"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Cockpit Bar (Live Speedometer, Remaining Distance & ETA, Destination, View Mode Toggle) -->
    <LinearLayout
        android:id="@+id/layoutBottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="16dp"
        android:background="#EB0F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Speedometer Box -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:background="#1E293B"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/tvSpeedKmh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Remaining Distance, ETA & Destination Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTripEtaAndDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- min • -- km"
                android:textColor="#34D399"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDestinationAndArrival"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No active route"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Camera Mode Toggle (3D Follow vs Route Overview) -->
        <TextView
            android:id="@+id/btnCameraMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="3D FOLLOW"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
